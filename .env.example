# Appointment form email (7.3) — Resend API key and the verified
# clinic-domain sender. Never use a Gmail/free-mail sender.
# [CONFIRM: domain DNS access] — sender domain needs SPF/DKIM/DMARC at launch.
RESEND_API_KEY=
RESEND_FROM="Dr. James Clinic <appointments@your-domain.example>"

# Cloudflare Turnstile spam check — optional; the widget and server
# verification only activate when both keys are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GA4 measurement id — analytics only load after cookie consent.
NEXT_PUBLIC_GA_ID=

# Public site URL used for canonicals, sitemap and JSON-LD.
SITE_URL=https://drjamesp.com

# Launch switch — keep unset until go-live. When not "true" the whole
# site is noindex (meta, X-Robots-Tag header and robots.txt Disallow).
# SITE_INDEXABLE=true
